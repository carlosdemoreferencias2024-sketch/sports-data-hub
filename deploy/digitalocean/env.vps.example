# Copy to .env on the VPS and fill real secrets there.
# Do not commit a real .env file.

POSTGRES_USER=sports_admin
POSTGRES_PASSWORD=change_me_on_vps
POSTGRES_DB=sports_db

INTERNAL_API_KEY=change_me_on_vps
API_KEY=change_me_on_vps

SPORTSDATAIO_MLB_ENABLED=true
SPORTSDATAIO_API_KEY=

API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_RATE_LIMIT_PER_MINUTE=10

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NODE_ENV=production
ENGINE_BIND_ADDRESS=127.0.0.1
ENGINE_HOST_PORT=4000
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5433
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=6380
METABASE_BIND_ADDRESS=127.0.0.1
METABASE_PORT=3001
METABASE_TIMEZONE=America/Matamoros

# Safety defaults. Keep these conceptually OFF unless the user explicitly authorizes.
REAL_MONEY_ENABLED=false
KELLY_ENABLED=false
TELEGRAM_AUTO_ENABLED=false

# Cloudflare Tunnel token from Zero Trust. Keep secret.
CLOUDFLARE_TUNNEL_TOKEN=

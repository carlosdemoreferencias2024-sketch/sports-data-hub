# Dedicated Bet365/BetsAPI odds worker
ODDS_SOURCE_MODE=betsapi_bet365
ODDS_SOURCE_URL=https://betsapi2.p.rapidapi.com/v1/bet365/upcoming?sport_id=16
ODDS_SOURCE_DETAIL_URL=https://betsapi2.p.rapidapi.com/v3/bet365/prematch
ODDS_SOURCE_PROVIDER=bet365_betsapi
ODDS_SOURCE_API_KEY_HEADER=x-rapidapi-key
ODDS_SOURCE_API_KEY=replace_with_rotated_rapidapi_key
ODDS_SOURCE_HOST=betsapi2.p.rapidapi.com

# Safety and rate-limit controls
ODDS_SOURCE_SKIP_ESPORTS=true
ODDS_SOURCE_ALLOW_REVERSED_MATCH=true
ODDS_SOURCE_ALLOW_DISCOVERY_MATCH=false
ODDS_SOURCE_MAX_PAGES=1
ODDS_SOURCE_MAX_DETAIL_REQUESTS=5
ODDS_SOURCE_DETAIL_DELAY_SECONDS=2.0
ODDS_WORKER_INTERVAL_SECONDS=300
ODDS_WORKER_STALE_SECONDS=600

# Shared HTTP protection
WORKER_HTTP_MAX_RETRIES=4
WORKER_HTTP_BACKOFF_BASE_SECONDS=15
WORKER_HTTP_BACKOFF_MAX_SECONDS=300

# Optional Alpha Telegram notifier. Rotate tokens before real use.
TELEGRAM_BOT_TOKEN=replace_with_rotated_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id
ALPHA_NOTIFY_MIN_EV=0.05

# Local scripts can use localhost; Docker Compose overrides this to db-postgres.
POSTGRES_USER=sports_admin
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_DB=sports_db
DATABASE_URL=postgres://sports_admin:replace_with_local_postgres_password@localhost:5433/sports_db
INTERNAL_API_KEY=replace_with_local_internal_api_key
API_KEY=replace_with_local_internal_api_key

# Optional data-only football adapter. Do not use a players/search endpoint as odds.
FOOTBALL_DATA_URL=
FOOTBALL_API_KEY=replace_with_rotated_rapidapi_key
FOOTBALL_API_HOST=free-api-live-football-data.p.rapidapi.com
FOOTBALL_WORKER_INTERVAL_SECONDS=900

# Optional Metabase BI profile
METABASE_PORT=3001
METABASE_TIMEZONE=America/Matamoros

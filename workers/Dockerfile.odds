FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY normalizer.py .
COPY base_worker.py .
COPY odds_worker.py .
COPY football_worker.py .
COPY fair_odds_engine.py .
COPY pre_bet_validator.py .
COPY source_manager.py .
COPY sportsdataio_validator.py .
COPY generate_stats_template.py .
COPY ingest_stats.py .
COPY optimizer.py .
COPY data_fetcher.py .
COPY model_pipeline.py .
COPY data_fetcher_nba.py .
COPY fair_odds_engine_nba.py .
COPY data_fetcher_football.py .
COPY fair_odds_engine_football.py .
COPY ingest_model_features.py .
COPY alpha_detector.py .
COPY webhook_notifier.py .
COPY settle_paper_trades.py .
COPY settle_real_paper_snapshots.py .
COPY parlay_generator.py .
COPY audit_mlb_stale_fixtures.py .
COPY audit_mlb_duplicate_fixtures.py .

CMD ["python", "odds_worker.py"]
